# Copy to deploy/.env and fill in. Never commit the real .env.
# Everything stays on your own servers: database, embeddings and the PARA mirror.

# --- Database (docker compose creates it with these values) ---
POSTGRES_USER=opsbrain
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=opsbrain
# The server and exporter build DATABASE_URL from the values above in docker-compose.yml.
# Set DATABASE_URL yourself only when you run OpsBrain outside compose.

# --- Server ---
# The URL people and agents use to reach OpsBrain (behind your reverse proxy / VPN / tunnel).
OPSBRAIN_PUBLIC_URL=https://opsbrain.example.internal
# Allow ?key= in the URL for clients that cannot send headers (Claude Desktop custom connectors).
# Headers are safer: keys in URLs can end up in proxy logs. Set to false if every client sends a header.
OPSBRAIN_ALLOW_QUERY_KEY=true
OPSBRAIN_MAX_RECORD_CHARS=50000

# --- Embeddings (semantic search) ---
# openai = any OpenAI-compatible /v1/embeddings endpoint (Ollama, vLLM, LiteLLM, OpenAI)
# none   = no embeddings; search falls back to Postgres full-text search
EMBEDDING_PROVIDER=openai
# Local Ollama from the "local-ai" compose profile. Keeps record text on your servers.
EMBEDDING_API_BASE=http://ollama:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# Must match the model's output size. Fixed when the database is first created.
EMBEDDING_DIM=768

# Optional: automatic tags for free-form notes, using a chat model at the same kind of endpoint.
METADATA_EXTRACTION=false
LLM_API_BASE=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# --- PARA markdown mirror ---
TZ=America/New_York
PARA_EXPORT_TIMES=00:00,06:00,12:00,18:00
PARA_EXPORT_ON_START=true
PARA_TITLE=OpsBrain
PARA_ARCHIVE_AFTER_DAYS=30
# Restricted records (HR, salaries, legal) are written ONLY here, never to the main mirror.
# Leave empty to skip exporting restricted records at all. Under docker compose use
# /data/para-restricted (it maps to ./para-restricted on the host; keep that folder chmod 700).
PARA_RESTRICTED_DIR=
# Commit each export to a git repository already initialized in the output folder (private remote only).
PARA_GIT_COMMIT=false
# Pushing from the container needs git credentials inside it; the simple path is to push from the host.
PARA_GIT_PUSH=false
PARA_GIT_AUTHOR_NAME=OpsBrain export
PARA_GIT_AUTHOR_EMAIL=opsbrain@localhost
