# OpsBrain's Open Brain REST API. Only the dashboard's server calls it; the browser never does.
# Docker Compose sets it to http://opsbrain:8787/open-brain-rest. For local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787/open-brain-rest

# Required: 32+ characters, encrypts the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: true behind HTTPS. Set false for a local http:// test.
# AUTH_COOKIE_SECURE=false

# Optional: SHA-256 of a passphrase that shows restricted records you can already read.
# Generate with: echo -n "your-passphrase" | shasum -a 256
# RESTRICTED_PASSPHRASE_HASH=

# Optional: the Dautel theme, fixed at build time (dautel, mocha, macchiato, frappe or latte).
# OPSBRAIN_UI_THEME=dautel

# Next.js sends no telemetry when this is set.
NEXT_TELEMETRY_DISABLED=1

# Optional: local walkthrough or screenshot mode only. Never enable it on a shared or production deployment.
# OB1_DEMO_AUTH_BYPASS=false
# OB1_DASHBOARD_DEMO_KEY=local-screenshot-key
